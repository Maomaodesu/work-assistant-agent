# Optional headless/deployment overrides. The Web setup wizard is preferred.
AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=Qwen3.6-35B-A3B

AGENT_DB_PATH=./data/agent.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
CONVERSATION_DB_PATH=./data/conversations.db
WORKSPACE_DB_PATH=./data/work_assistant.db
SNAPSHOT_DIR=./snapshots
DEFAULT_PROJECT_PATHS=

REQUEST_TIMEOUT_SECONDS=180
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Keep disabled for normal Windows use. Enable only while actively developing the server.
SERVER_RELOAD=false
SEND_DIFF_SUMMARY=true
SEND_COMMIT_INFO=true

# Set true only for non-Web/headless deployments after supplying AMD_API_KEY.
WORK_ASSISTANT_SETUP_COMPLETED=false
